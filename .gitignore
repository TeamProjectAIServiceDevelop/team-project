# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# 평가: 실제 사진과 실행 결과는 올리지 않는다 (labels.jsonl과 시험용 sample은 올린다)
/eval/data/*/images/
!/eval/data/sample/images/
/eval/results/
# 파인튜닝 학습 사진: 일부가 블로그 사진이라 올리지 않는다 (라벨과 스크립트만 올린다)
/finetune/data/*/images/

# typescript
*.tsbuildinfo
next-env.d.ts
